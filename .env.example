# Local development settings for the API. Copy to `.env` (git-ignored) and fill in.
# In Kubernetes these come from a ConfigMap; the secret ones (DB_PASSWORD, JWT_SECRET)
# come from AWS SSM / Secrets Manager via External Secrets — never from this file.

APP_ENV=local
LOG_LEVEL=INFO
# json in containers (for Loki), console is easier to read locally
LOG_FORMAT=console

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiretrack
DB_USER=hiretrack
# secret
DB_PASSWORD=change-me
# disable locally; require on RDS
DB_SSLMODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5

# --- API ---
PORT=8000
# secret, min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=60
# comma-separated browser origins allowed to call the API (the Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOW_REGISTRATION=true
# chaos testing: 0.0 = off, 0.3 = 30% of /api/* requests return 500
FAULT_INJECTION_RATE=0.0
# seconds to finish in-flight requests after SIGTERM (keep below terminationGracePeriodSeconds)
SHUTDOWN_GRACE_SECONDS=20

# --- Practice interviewer ---
# none = built-in question bank, scored by key-point coverage (free, offline)
# anthropic = Claude writes role-specific questions and grades answers (paid API usage)
LLM_PROVIDER=none
# secret, only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low keeps answers fast and cheap; medium/high grade more thoroughly
ANTHROPIC_EFFORT=low
# per LLM call; on timeout or error the rule-based interviewer takes over
LLM_TIMEOUT_SECONDS=30

# --- Smart Apply: queue (job-scout publishes, match-scorer consumes) ---
# redis = Redis Streams (local/docker-compose), sqs = Amazon SQS (cloud)
QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=hiretrack-jobs
REDIS_CONSUMER_GROUP=match-scorer
# SQS only. No access keys anywhere: in EKS, Pod Identity provides credentials.
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/hiretrack-jobs
# AWS_REGION=ap-south-1
# seconds a received message stays hidden; must exceed the slowest processing time
QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
# failed deliveries before the dead-letter queue (SQS: same as the redrive maxReceiveCount)
QUEUE_MAX_RECEIVES=5

# --- job-scout (CronJob) ---
SOURCES_FILE=config/sources.yaml
SCOUT_REQUEST_DELAY_SECONDS=1.0
SCOUT_REQUEST_TIMEOUT_SECONDS=15
SCOUT_MAX_RETRIES=3
SCOUT_BACKOFF_BASE_SECONDS=2.0
# CronJobs push metrics here before exiting; leave empty locally
PUSHGATEWAY_URL=

# --- match-scorer (worker) ---
SKILLS_FILE=config/skills.yaml
MATCH_MIN_SCORE_TO_STORE=40
OPS_PORT=9100
HEARTBEAT_MAX_AGE_SECONDS=300
SCORER_BATCH_SIZE=10
SCORER_WAIT_SECONDS=10
# the scorer reuses LLM_PROVIDER / ANTHROPIC_* above for application kits

# --- reminder-worker (CronJob) ---
# APPLIED applications with no change for this many days get a follow-up reminder
FOLLOW_UP_AFTER_DAYS=7

# --- triage-bot (Alertmanager webhook -> GitHub issue) ---
# secret: Alertmanager sends it as "Authorization: Bearer <token>" (min 24 chars)
WEBHOOK_TOKEN=
# both empty = dry run (issues are only logged). Token: fine-grained PAT, Issues read/write, one repo
GITHUB_REPO=
GITHUB_TOKEN=
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
LOOKBACK_MINUTES=15
RUNBOOK_BASE_URL=https://github.com/Abhas16/hiretrack-platform/blob/main/docs/runbooks
