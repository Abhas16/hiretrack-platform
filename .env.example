# Local development settings for the API. Copy to `.env` (git-ignored) and fill in.
# In Kubernetes these come from a ConfigMap; the secret ones (DB_PASSWORD, JWT_SECRET)
# come from AWS SSM / Secrets Manager via External Secrets — never from this file.

APP_ENV=local
LOG_LEVEL=INFO
# json in containers (for Loki), console is easier to read locally
LOG_FORMAT=console

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiretrack
DB_USER=hiretrack
# secret
DB_PASSWORD=change-me
# disable locally; require on RDS
DB_SSLMODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5

# --- API ---
PORT=8000
# secret, min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=60
# comma-separated browser origins allowed to call the API (the Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOW_REGISTRATION=true
# chaos testing: 0.0 = off, 0.3 = 30% of /api/* requests return 500
FAULT_INJECTION_RATE=0.0
# seconds to finish in-flight requests after SIGTERM (keep below terminationGracePeriodSeconds)
SHUTDOWN_GRACE_SECONDS=20

# --- Practice interviewer ---
# none = built-in question bank, scored by key-point coverage (free, offline)
# anthropic = Claude writes role-specific questions and grades answers (paid API usage)
LLM_PROVIDER=none
# secret, only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low keeps answers fast and cheap; medium/high grade more thoroughly
ANTHROPIC_EFFORT=low
# per LLM call; on timeout or error the rule-based interviewer takes over
LLM_TIMEOUT_SECONDS=30
