# RDS PostgreSQL in the database subnets. Only the EKS nodes (and so the pods) can reach it.
#
# The password is generated by an EPHEMERAL resource and given to RDS and SSM through
# write-only arguments (password_wo / value_wo): AWS receives it, the Terraform state never
# contains it. Bump var.secrets_version to rotate it.

ephemeral "random_password" "db" {
  length  = 32
  special = false # avoids quoting problems in connection strings
}

resource "aws_security_group" "rds" {
  name        = "${local.name}-rds"
  description = "PostgreSQL from the EKS nodes only"
  vpc_id      = module.vpc.vpc_id
}

# Pods use the node security group (no security groups for pods), so allowing the node SG
# allows every pod. NetworkPolicies limit which pods talk to what inside the cluster.
resource "aws_vpc_security_group_ingress_rule" "rds_from_nodes" {
  security_group_id            = aws_security_group.rds.id
  referenced_security_group_id = module.eks.node_security_group_id
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432
  description                  = "PostgreSQL from EKS nodes"
}

resource "aws_db_instance" "main" {
  identifier = local.name

  engine                     = "postgres"
  engine_version             = var.db_engine_version
  auto_minor_version_upgrade = true
  instance_class             = var.db_instance_class

  allocated_storage     = 20
  max_allocated_storage = 50 # storage autoscaling up to 50 GB
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name             = "hiretrack"
  username            = "hiretrack"
  password_wo         = ephemeral.random_password.db.result
  password_wo_version = var.secrets_version

  db_subnet_group_name   = module.vpc.database_subnet_group_name
  vpc_security_group_ids = [aws_security_group.rds.id]
  publicly_accessible    = false
  multi_az               = false # dev: one AZ. Prod: true (standby in a second AZ, auto failover)

  # The app connects with DB_SSLMODE=require; this makes the server refuse non-TLS too.
  parameter_group_name = aws_db_parameter_group.main.name

  backup_retention_period = 3
  backup_window           = "19:00-20:00" # UTC = 00:30-01:30 IST
  maintenance_window      = "sun:20:30-sun:21:30"

  performance_insights_enabled = true # free tier: 7 days of retention

  # dev: teardown must be quick and free. Prod: deletion_protection = true + a final snapshot.
  deletion_protection = false
  skip_final_snapshot = true
  apply_immediately   = true
}

resource "aws_db_parameter_group" "main" {
  name   = "${local.name}-pg${var.db_engine_version}"
  family = "postgres${var.db_engine_version}"

  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }
  # Log statements slower than 500 ms (shows up in CloudWatch / the RDS console).
  parameter {
    name  = "log_min_duration_statement"
    value = "500"
  }
}
