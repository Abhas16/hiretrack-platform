# App secrets in SSM Parameter Store (SecureString, encrypted with the AWS-managed KMS key).
# External Secrets Operator copies them into Kubernetes Secrets (deploy/helm + deploy/platform):
#
#   /hiretrack/dev/app/DB_PASSWORD     -> hiretrack/hiretrack-secrets   (same value as RDS)
#   /hiretrack/dev/app/JWT_SECRET      -> hiretrack/hiretrack-secrets
#   /hiretrack/dev/app/WEBHOOK_TOKEN   -> hiretrack/hiretrack-secrets + monitoring/triage-bot-webhook
#   /hiretrack/dev/grafana/admin-password -> monitoring/grafana-admin
#
# Values are generated by ephemeral resources and written with value_wo: never in the state.
# Optional secrets (GITHUB_TOKEN for triage-bot issues, ANTHROPIC_API_KEY) are NOT made here;
# put them in by hand so they never touch Terraform:
#   aws ssm put-parameter --type SecureString --name /hiretrack/dev/app/GITHUB_TOKEN --value ...

locals {
  ssm_prefix = "/hiretrack/${var.environment}"
}

ephemeral "random_password" "jwt" {
  length  = 64 # the API requires >= 32 characters
  special = false
}

ephemeral "random_password" "webhook" {
  length  = 40 # the triage-bot requires >= 24 characters
  special = false
}

ephemeral "random_password" "grafana" {
  length  = 24
  special = false
}

resource "aws_ssm_parameter" "db_password" {
  name             = "${local.ssm_prefix}/app/DB_PASSWORD"
  description      = "RDS password of the hiretrack user"
  type             = "SecureString"
  value_wo         = ephemeral.random_password.db.result # same instance as rds.tf -> same value
  value_wo_version = var.secrets_version
}

resource "aws_ssm_parameter" "jwt_secret" {
  name             = "${local.ssm_prefix}/app/JWT_SECRET"
  description      = "Signing key for the API's JWTs"
  type             = "SecureString"
  value_wo         = ephemeral.random_password.jwt.result
  value_wo_version = var.secrets_version
}

resource "aws_ssm_parameter" "webhook_token" {
  name             = "${local.ssm_prefix}/app/WEBHOOK_TOKEN"
  description      = "Bearer token Alertmanager sends to the triage-bot"
  type             = "SecureString"
  value_wo         = ephemeral.random_password.webhook.result
  value_wo_version = var.secrets_version
}

resource "aws_ssm_parameter" "grafana_admin_password" {
  name             = "${local.ssm_prefix}/grafana/admin-password"
  description      = "Grafana admin password"
  type             = "SecureString"
  value_wo         = ephemeral.random_password.grafana.result
  value_wo_version = var.secrets_version
}
