    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.89.0",
    "react-router": "7.18.4",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
